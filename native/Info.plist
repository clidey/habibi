<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Habibi</string>
	<key>CFBundleExecutable</key>
	<string>Habibi</string>
	<key>CFBundleIconFile</key>
	<string>Habibi</string>
	<key>CFBundleIdentifier</key>
	<string>com.clidey.habibi</string>
	<key>CFBundleName</key>
	<string>Habibi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Habibi uses Automation to run system actions you confirm, and to open Terminal for agent sessions you start.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Habibi uses your calendar only to show upcoming events and prepare event drafts you approve.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Habibi uses your calendar only to show upcoming events and prepare event drafts you approve.</string>
	<key>NSContactsUsageDescription</key>
	<string>Habibi looks up a contact's name for a WhatsApp number already shown to you, entirely on this Mac.</string>
	<!-- File search (mdfind/find, unsandboxed but still TCC-gated on modern
	     macOS) walks Documents, Desktop, and Downloads. Without these three
	     usage strings TCC denies access silently — no prompt, no error — which
	     is exactly the bug this fixes: search worked in an ad-hoc local build
	     (no prior denial recorded for that signing identity) but failed after
	     signing/notarizing, where a prior denial for com.clidey.habibi was
	     already on record. -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Habibi searches file names in your Documents folder so you can find and open them from the launcher.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Habibi searches file names on your Desktop so you can find and open them from the launcher.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Habibi searches file names in your Downloads folder so you can find and open them from the launcher.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
