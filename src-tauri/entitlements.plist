<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Developer ID distribution, notarized, hardened runtime, NOT sandboxed:
      the shell spawns login shells for the agent terminal, runs MCP stdio
      servers and drives Calendar/Finder/Terminal over AppleEvents, none of
      which App Sandbox allows. Unlike the Swift build there is no bundled
      Node, so the JIT and library-validation exceptions are gone.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Under hardened runtime TCC will not show these prompts without the
         matching entitlement; Info.plist supplies the prompt text. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <!-- Used only while the user starts voice-following in the teleprompter. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.speech-recognition</key>
    <true/>
</dict>
</plist>
