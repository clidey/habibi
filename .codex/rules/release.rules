# These scripts sign with the Developer ID and submit to Apple's notary
# service; they need the user's go-ahead.
RELEASE_SCRIPTS = [
    "native/sign-app.sh", "./native/sign-app.sh",
    "native/package-whatsapp-component.sh", "./native/package-whatsapp-component.sh",
    "habibi/native/sign-app.sh", "habibi/native/package-whatsapp-component.sh",
]

prefix_rule(
    pattern = [RELEASE_SCRIPTS],
    decision = "prompt",
    justification = "Signs and notarizes with Apple; it needs the user's go-ahead",
    match = ["native/sign-app.sh", "./native/package-whatsapp-component.sh"],
)
prefix_rule(
    pattern = [["bash", "sh", "zsh"], RELEASE_SCRIPTS],
    decision = "prompt",
    justification = "Signs and notarizes with Apple; it needs the user's go-ahead",
    match = ["zsh native/sign-app.sh"],
)
prefix_rule(
    pattern = ["gh", "workflow", "run"],
    decision = "prompt",
    justification = "Starting a workflow (release.yml publishes a release) needs the user's go-ahead",
    match = ["gh workflow run release.yml"],
)
prefix_rule(
    pattern = ["gh", "release"],
    decision = "prompt",
    justification = "Releases are the user's",
    match = ["gh release create v1.0.0"],
)
