{
  "name": "habibi",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first, privacy-preserving command center for macOS, Windows and Linux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clidey/habibi.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:references": "node scripts/check-references.mjs",
    "validate:manifests": "cargo test -p habibi-local every_repository_manifest_is_valid",
    "test": "pnpm run build && node --test dist/test/**/*.test.js",
    "check": "pnpm run typecheck && pnpm run typecheck:references && pnpm test && pnpm run check:rust",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "start": "pnpm run tauri:dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev:server": "cargo run -p habibi-devserver",
    "check:ui": "pnpm run build && node scripts/check-ui-layout.mjs",
    "check:assistant-ui": "pnpm run build && node scripts/check-assistant-tools-ui.mjs",
    "generate:demo-screenshots": "node scripts/generate-demo-screenshots.mjs",
    "bench:search": "cargo run --release -p habibi-local --example search_benchmark --",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "docs:check": "pnpm --dir docs run check",
    "docs:build": "pnpm --dir docs run build",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:preview": "pnpm --dir docs run preview"
  },
  "dependencies": {
    "escape-html": "1.0.3"
  },
  "devDependencies": {
    "@clidey/ux": "1.6.4",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "26.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.13",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "marked": "18.1.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "7.0.2"
  }
}
