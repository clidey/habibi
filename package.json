{
  "name": "habibi",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first, privacy-preserving command center for macOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clidey/habibi.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:client && pnpm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "generate:demo-screenshots": "node scripts/generate-demo-screenshots.mjs",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:references": "node scripts/check-references.mjs",
    "validate:manifests": "pnpm run build && node scripts/validate-manifests.mjs",
    "check": "pnpm run typecheck && pnpm run typecheck:references && pnpm run validate:manifests && npm test",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "start": "pnpm run build && HABIBI_ROOT=. node dist/server.js",
    "test": "pnpm run build && node --test dist/test/**/*.test.js",
    "check:ui": "pnpm run build && node scripts/check-ui-layout.mjs",
    "docs:check": "pnpm --dir docs run check",
    "docs:build": "pnpm --dir docs run build",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:preview": "pnpm --dir docs run preview"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "0.82.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "escape-html": "1.0.3",
    "imapflow": "1.6.1",
    "mailparser": "3.9.14",
    "node-pty": "1.1.0",
    "nodemailer": "9.0.3",
    "sanitize-html": "2.17.6",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@clidey/ux": "1.6.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.13",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "marked": "18.1.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "7.0.2"
  }
}
