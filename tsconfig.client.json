{
  // Catches undefined identifiers and unresolved imports in the browser code,
  // which esbuild silently treats as globals. Deliberately not full strict
  // checking: this guards the one failure mode (a missing import shipping a
  // ReferenceError to the UI) without demanding the client be typed.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true
  },
  "include": ["app.js", "src/client/**/*.js"]
}
